# Copy to .env.local and fill in. .env*.local is gitignored.
#
# Every value here is OPTIONAL for local development — with none of them set
# the site runs and the quote form works, logging enquiries to the server
# console instead of emailing them.

# --- Site ---------------------------------------------------------------
# Canonical origin. Used for canonicals, OG tags, sitemap and JSON-LD.
# Leave unset locally. In production set it to exactly the value below —
# including the `www.` and with no trailing slash. If it doesn't match
# PRODUCTION_URL in src/content/site.ts the build is treated as a demo and
# every page goes noindex.
NEXT_PUBLIC_SITE_URL=https://www.matterconstruction.nz

# --- Enquiry email (Resend) ---------------------------------------------
# https://resend.com → API Keys. Without this, enquiries are logged, not sent.
RESEND_API_KEY=

# ⚠️ CONFIRM WITH THE CLIENT — these addresses are still on the OLD domain
# (matterconnect.net) after the move to matterconstruction.nz. They've been
# left as-is deliberately: guessing a new address would silently send every
# enquiry into a black hole. Check which mailbox Jack actually reads, then
# update both of these and `email` in src/content/site.ts together.

# Where quote requests land.
ENQUIRY_TO=info@matterconnect.net

# The From address. MUST be on a domain verified in Resend — if the mailbox
# moves to matterconstruction.nz, that domain needs verifying there first.
# Until then, use Resend's shared sender:
#   Matter Construction <onboarding@resend.dev>
ENQUIRY_FROM=Matter Construction <enquiries@matterconnect.net>

# --- Analytics ----------------------------------------------------------
# Google Tag Manager container. Defaults to GTM-ML32GVVQ in code, so leave this
# unset unless you're pointing at a different container. Set it to an empty
# value to switch tagging off completely.
NEXT_PUBLIC_GTM_ID=

# GA4 measurement ID (G-XXXXXXXXXX). Unset = no analytics script loads at all.
#
# ⚠️ Leave this UNSET now that Tag Manager is installed — add GA4 as a tag
# inside the GTM container instead. Setting both loads Analytics twice and
# double-counts every page view.
NEXT_PUBLIC_GA_ID=
